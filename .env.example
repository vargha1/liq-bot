# ── Required ──────────────────────────────────────────────────────────────────
RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_WS=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=your_private_key_here
CONTRACT_ADDRESS=0xYourDeployedLiquidatorContract

# ── Tuning ────────────────────────────────────────────────────────────────────
# Minimum net profit in USD to execute a liquidation (default: 0.10)
MIN_PROFIT_USD=0.10

# Positions checked per polling cycle (default: 300). Sub-chunks of MC_SUBCHUNK
# size are dispatched concurrently — the sweep is a safety net; fast detection
# comes from the trigger engine and price-drop wakes.
POSITIONS_PER_CYCLE=300

# Multicall3 sub-chunk size for the getUserAccountData scan (default: 50).
# Lower this if your RPC provider rejects large batched multicalls with a
# "missing revert data" / CALL_EXCEPTION error (common on shared/free-tier
# nodes — e.g. Chainstack's Global Node — which cap eth_call gas or complexity
# more conservatively than a dedicated/paid endpoint). Try 25 or 10 if 50 still
# fails; test with `npm run diagnose` and watch the logs after each change.
MC_SUBCHUNK=50

# Multicall3 chunk size for the one-time startup prune scan (default: 500).
# Same "missing revert data" failure mode as MC_SUBCHUNK above, but for the
# much larger prune pass — lower this FIRST if the prune itself is failing,
# since 500 is a bigger request than the regular cycle scan ever sends.
PRUNE_CHUNK=500

# Global cap on NEW eth_call requests started per second on the shared provider
# (default: 4). This is the fix for "missing revert data" CALL_EXCEPTION errors
# on restricted RPC plans (e.g. Chainstack's shared/free tier). NOTE: a
# concurrency cap (max N calls in flight at once) was tried first and did NOT
# help — dropping it from 4 to 2 barely changed the failure rate, since
# fast-resolving calls can still burst past a requests-per-second limit even
# with few outstanding at once. This is a true rate limiter: it paces how
# often NEW calls are allowed to start, regardless of concurrency. Default of
# 4 matches the pace the startup prune sustains successfully. Lower further
# (2-3) if errors persist; raise if your provider tolerates more.
RPC_CALLS_PER_SECOND=4

# Minimum gap between polling sweeps in ms (default: 1000).
# Arbitrum blocks are ~250ms and the sweep used to fire on every block, re-arming
# itself immediately — it ran continuously and consumed the whole eth_call budget.
# With the event-driven trigger working, the sweep is a safety net and does not
# need to run every block; detection latency is unaffected because the trigger
# fires on Chainlink events independently of this. Set 0 for the old behaviour.
CYCLE_MIN_INTERVAL_MS=1000

# Danger-tier positions whose breakdown is pre-warmed per sweep (default: 40).
# Far less important now that the in-memory model covers the whole watchlist —
# the trigger engine no longer depends on a position having been pre-warmed.
# Kept as a warm-start nudge for the most at-risk positions.
PREWARM_MAX=40

# Max gas price in gwei — bot will warn if Arbitrum gasPrice exceeds this (default: 2)
MAX_GAS_GWEI=2

# Slippage for Uniswap V3 collateral swap in bps (default: 100 = 1%).
# Also applied when deriving amountOutMinimum from oracle prices.
SLIPPAGE_BPS=100

# On-chain deadline guard in seconds, calibrated against chain clock skew
# (default: 20). Stale txs revert cleanly instead of executing late.
DEADLINE_SECS=20

# ── OPT 1: Timeboost / sequencer priority ─────────────────────────────────────
# Optional: separate RPC endpoint for tx submission (lower latency to sequencer).
# Leave empty to use RPC_URL. Example: a node geographically close to Arbitrum's
# sequencer in Chicago gives a few ms FCFS advantage.
# SUBMIT_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_FASTER_KEY

# Also broadcast every signed liquidation straight to Arbitrum's public sequencer
# (default: true). Removes the forwarding hop your RPC provider adds on the one
# path where latency decides whether you win the race.
BROADCAST_TO_SEQUENCER=true

# Priority fee tip in gwei (default: 0.1).
# NOTE: this does NOT buy earlier ordering. Arbitrum's sequencer is strictly
# first-come-first-served by arrival time; priority fees do not reorder
# transactions. Ordering is decided by arrival time and, above that, by
# Timeboost's express lane — which is auctioned in ~60s rounds, not tipped for,
# and delays every non-express transaction by ~200ms. The tip is kept only
# because it is harmless and nearly free on L2.
TIMEBOOST_PRIORITY_GWEI=0.1

# ── Sequencer feed accelerator ────────────────────────────────────────────────
# Arbitrum broadcasts transactions as it orders them, BEFORE the block carrying
# them is published. Watching that feed for a Chainlink transmit() beats every
# bot waiting on a log subscription.
#
# Leave this false until `npm run check-feed` reports matched aggregator calls
# from YOUR network. It decodes Arbitrum's message framing and Chainlink's OCR
# report layout, both of which can change upstream — and because it is a pure
# accelerator (the AnswerUpdated subscription stays authoritative), a decode that
# stops matching costs you the head start silently rather than erroring.
SEQUENCER_FEED_ENABLED=false
SEQUENCER_FEED_URL=wss://arb1.arbitrum.io/feed

# ── OPT 3: Parallel execution ─────────────────────────────────────────────────
# Max simultaneous liquidation txs (default: 3). Each uses a separate nonce slot.
# Increase during crash events when many positions are liquidatable at once.
MAX_CONCURRENT_EXECUTIONS=3

# ── OPT 4/5: Quote optimisation ───────────────────────────────────────────────
# Positions with debt below this USD amount use a fast 800ms Uniswap quote timeout
# instead of the full 1500ms timeout (default: 50).
MIN_DEBT_FOR_QUOTE_USD=50

# ── Optional ──────────────────────────────────────────────────────────────────
THEGRAPH_API_KEY=your_thegraph_key
LOG_LEVEL=info

# ── Event-driven trigger engine (recommended) ────────────────────────────────
# Subscribes to Chainlink AnswerUpdated events for all reserve feeds. On each
# price update, recomputes HF locally from cached breakdowns and submits
# immediately — detection in ~block propagation time instead of cycle time.
TRIGGER_ENABLED=true

# ── Bug #4 fix: Flashloan premium ─────────────────────────────────────────────
# Aave V3 flashloan premium is governance-configurable. Default is 5 bps (0.05%).
# If Aave changes the premium, update this value to match on-chain config.
# FLASHLOAN_PREMIUM_BPS=5
